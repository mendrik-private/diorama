{
  "app-id": "io.github.mendrik.Diorama",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "diorama",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--filesystem=host",
    "--talk-name=org.freedesktop.portal.Desktop"
  ],
  "modules": [
    {
      "name": "glycin-heif-codec-path",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 diorama-glycin-heif /app/libexec/diorama-glycin-heif",
        "install -Dm644 diorama-glycin-heif.conf /app/share/glycin-loaders/2+/conf.d/diorama-glycin-heif.conf"
      ],
      "sources": [
        {
          "type": "file",
          "path": "diorama-glycin-heif"
        },
        {
          "type": "file",
          "path": "diorama-glycin-heif.conf"
        }
      ]
    },
    {
      "name": "diorama",
      "buildsystem": "meson",
      "config-opts": [
        "--buildtype=release"
      ],
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
          "CARGO_HOME": "/run/build/diorama/cargo",
          "CARGO_NET_OFFLINE": "true"
        }
      },
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            ".git",
            ".github",
            ".flatpak-builder",
            "build",
            "target"
          ]
        },
        "cargo-sources.json"
      ]
    }
  ]
}
