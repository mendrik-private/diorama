<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.mendrik_private.Diorama</id>
  <name>Diorama</name>
  <summary>View, compare, and edit images</summary>
  <developer id="io.github.mendrik_private">
    <name>Mendrik</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <description>
    <p>Diorama is a fast native GNOME image viewer for browsing, comparing, and making focused non-destructive edits to images.</p>
    <p>Inspect pixel details, compare related images side by side, and annotate with drawings, arrows, measurements, and text. Crop, resize, and export images while keeping edits reversible during your session.</p>
  </description>
  <url type="homepage">https://github.com/mendrik-private/diorama</url>
  <url type="bugtracker">https://github.com/mendrik-private/diorama/issues</url>
  <url type="vcs-browser">https://github.com/mendrik-private/diorama</url>
  <translation type="gettext">diorama</translation>
  <launchable type="desktop-id">io.github.mendrik_private.Diorama.desktop</launchable>
  <content_rating type="oars-1.1" />
  <screenshots>
    <screenshot type="default">
      <image width="1280" height="800">https://raw.githubusercontent.com/mendrik-private/diorama/v0.3.5/data/screenshots/browse.png</image>
      <caption>Browse images and inspect pixel art</caption>
    </screenshot>
    <screenshot>
      <image width="1280" height="800">https://raw.githubusercontent.com/mendrik-private/diorama/v0.3.5/data/screenshots/selection.png</image>
      <caption>Select a region with live coordinates and dimensions</caption>
    </screenshot>
  </screenshots>
  <releases>
    <release version="0.3.5" date="2026-09-08">
      <description>
        <p>Adopts the io.github.mendrik_private.Diorama application ID, narrows filesystem permissions to Pictures and removable media, and adds store screenshots and portable HEIF codec discovery.</p>
      </description>
    </release>
    <release version="0.3.4" date="2026-09-08">
      <description>
        <p>Adds live coordinate and dimension labels to region selections.</p>
      </description>
    </release>
    <release version="0.3.3" date="2026-09-08">
      <description>
        <p>Adds native image printing with paper and printer selection, and keeps the minimap visibility in sync with zooming and viewport resizing.</p>
      </description>
    </release>
    <release version="0.3.2" date="2026-09-05">
      <description>
        <p>Improves the Pencil so click-only dots are committed without resize controls and right-click color sampling cannot leave stray marks, and introduces a product-focused feature guide.</p>
      </description>
    </release>
    <release version="0.3.1" date="2026-09-05">
      <description>
        <p>Fixes Fit zoom so images use the full available viewport at any scale, restores exact 100% zoom, and improves keyboard image navigation and drawing-tool viewport stability.</p>
      </description>
    </release>
    <release version="0.3.0" date="2026-09-04">
      <description>
        <p>Adds editable vector highlights, arrows, measurements, and curved text; improves pixel-perfect zoom under fractional scaling; and removes object-segmentation downloads.</p>
      </description>
    </release>
    <release version="0.2.8" date="2026-08-13" />
    <release version="0.2.6" date="2026-07-30" />
    <release version="0.2.5" date="2026-07-29" />
    <release version="0.2.4" date="2026-07-29" />
    <release version="0.2.3" date="2026-07-27" />
    <release version="0.2.2" date="2026-07-25" />
    <release version="0.2.1" date="2026-07-24" />
    <release version="0.2.0" date="2026-07-21" />
    <release version="0.1.0" date="2026-07-17" />
  </releases>
</component>
