  <releases>
    <release version="0.3.20" date="2026-09-24">
      <description>
        <p>Improves vector contour extraction for Game Asset scaling, replaces contour darkening with opacity, and uses the pen tool’s antialiasing algorithm while retaining adjustable AA strength. Pinch zoom also continues after keyboard zoom across viewport margins.</p>
      </description>
    </release>
    <release version="0.3.19" date="2026-09-23">
      <description>
        <p>Adds editable mesh warping with square, dimetric, and isometric guides; paste and move image cutouts; and crop-to-content and square-up tools. Pencil line vertices can snap and stay linked, and highlights can rotate. Also improves Game Asset scaling for transparent sprites and opaque backgrounds.</p>
      </description>
    </release>
    <release version="0.3.18" date="2026-09-19">
      <description>
        <p>Adds native bundled BiRefNet inference for selection cutouts. Released Flatpaks include the verified model so foreground masks are created without a host-installed Python runtime or inference executable.</p>
      </description>
    </release>
    <release version="0.3.17" date="2026-09-19">
      <description>
        <p>Adds opt-in embedded Python runtime packaging for local LaMa inpainting: archives are validated at build and extraction, cached by hash, and run the packaged worker in isolated mode. Published Flatpak releases retain the configured host-Python fallback.</p>
      </description>
    </release>
    <release version="0.3.16" date="2026-09-17">
      <description>
        <p>Adds eager local foreground cutouts for rectangle selections: click to activate a contour-following lasso, including holes, then drag it anywhere, including beyond the image. The original area receives cached local LaMa content-aware fill or the detected background or transparency fallback, and every cut, move, and Delete fill can be undone.</p>
      </description>
    </release>
    <release version="0.3.15" date="2026-09-16">
      <description>
        <p>Asks for confirmation before permanently deleting the current image when no annotation or region is selected, while keeping annotation and region deletion actions unchanged.</p>
      </description>
    </release>
    <release version="0.3.14" date="2026-09-16">
      <description>
        <p>Restores Arrow endpoint rotation, stroke-width Escape and canvas-blur behavior for Delete and undo, and scale-preview zoom across dimension, antialiasing, and method changes. Also improves Game Asset silhouette edge and background separation.</p>
      </description>
    </release>
    <release version="0.3.13" date="2026-09-15">
      <description>
        <p>Speeds up Game Asset scaling and preserves continuous contours with biharmonic texture filling. Adds adjustable antialiasing with a 50% default and a compact numeric control, plus Copy Filepath in the main menu. Also fixes zoom levels.</p>
      </description>
    </release>
    <release version="0.3.12" date="2026-09-14">
      <description>
        <p>Adds contour-aware Game Asset reduction with tight antialiasing, median fill correction, and automatic contour weighting. Also refines annotation rendering and removes obsolete scaling modes.</p>
      </description>
    </release>
    <release version="0.3.11" date="2026-09-12">
      <description>
        <p>Adds Crop to Content, Square Up, and Canvas Resize with automatic solid or transparent background detection. Also lets number keys enter values in focused text fields instead of triggering global zoom shortcuts.</p>
      </description>
    </release>
    <release version="0.3.10" date="2026-09-11">
      <description>
        <p>Fixes pinch zoom jumping to another scale on release and keeps the image anchored while zooming through centered margins and pending layout changes.</p>
      </description>
    </release>
    <release version="0.3.9" date="2026-09-11">
      <description>
        <p>Adds rotation for Pencil rectangles and ellipses, improves curved text with kerning and proportional scaling, makes highlights and circles grow from their center while drawing, and prevents tool focus from shifting a zoomed canvas.</p>
      </description>
    </release>
    <release version="0.3.8" date="2026-09-10">
      <description>
        <p>Fixes single-pixel Pencil dots so they never capture a subsequent draw action or expose drag and resize controls.</p>
      </description>
    </release>
    <release version="0.3.7" date="2026-09-09">
      <description>
        <p>Adds a distraction-free fullscreen preview, makes image comparison read-only while retaining mirrored pixel inspection, fixes curved-arrow editing, and improves comparison layout and rendering stability.</p>
      </description>
    </release>
    <release version="0.3.6" date="2026-09-08">
      <description>
        <p>Updates the application icon, adds comparison and pixel-inspection screenshots, and expands the store description with feature highlights.</p>
      </description>
    </release>
    <release version="0.3.5" date="2026-09-08">
      <description>
        <p>Adopts the io.github.mendrik_private.Diorama application ID, narrows filesystem permissions to Pictures and removable media, and adds store screenshots and portable HEIF codec discovery.</p>
      </description>
    </release>
    <release version="0.3.4" date="2026-09-08">
      <description>
        <p>Adds live coordinate and dimension labels to region selections.</p>
      </description>
    </release>
    <release version="0.3.3" date="2026-09-08">
      <description>
        <p>Adds native image printing with paper and printer selection, and keeps the minimap visibility in sync with zooming and viewport resizing.</p>
      </description>
    </release>
    <release version="0.3.2" date="2026-09-05">
      <description>
        <p>Improves the Pencil so click-only dots are committed without resize controls and right-click color sampling cannot leave stray marks, and introduces a product-focused feature guide.</p>
      </description>
    </release>
    <release version="0.3.1" date="2026-09-05">
      <description>
        <p>Fixes Fit zoom so images use the full available viewport at any scale, restores exact 100% zoom, and improves keyboard image navigation and drawing-tool viewport stability.</p>
      </description>
    </release>
    <release version="0.3.0" date="2026-09-04">
      <description>
        <p>Adds editable vector highlights, arrows, measurements, and curved text; improves pixel-perfect zoom under fractional scaling; and removes object-segmentation downloads.</p>
      </description>
    </release>
    <release version="0.2.8" date="2026-08-13" />
