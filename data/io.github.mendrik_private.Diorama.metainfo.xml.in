<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.mendrik_private.Diorama</id>
  <name>Diorama</name>
  <summary>View, compare, and edit images</summary>
  <developer id="io.github.mendrik_private">
    <name>Mendrik</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <description>
    <p>Diorama brings image browsing, pixel inspection, comparison, and focused editing into one native GNOME app. Move through a folder, compare related images, and mark up what matters without opening a full graphics suite.</p>
    <ul>
      <li>Browse a single image, an ordered selection, or an entire folder with keyboard navigation and neighboring-image prefetching.</li>
      <li>Inspect details with true 100% zoom, a pixel lens, copyable color values, metadata, and selectable transparency backgrounds.</li>
      <li>Compare two images with synchronized pan and zoom, adaptive split views, and a cross-image detail lens.</li>
      <li>Crop, resize, rotate, flip, and reduce colors with undo and redo throughout your editing session.</li>
      <li>Draw and annotate with freehand strokes, highlights, curved arrows, pixel measurements, and editable text.</li>
      <li>Export PNG or JPEG images with explicit quality, metadata, color-profile, and transparency choices.</li>
    </ul>
    <p>Image processing stays local, and edits remain reversible during the session until you choose to save or export. Diorama is under active development ahead of its first stable release.</p>
  </description>
  <url type="homepage">https://github.com/mendrik-private/diorama</url>
  <url type="bugtracker">https://github.com/mendrik-private/diorama/issues</url>
  <url type="vcs-browser">https://github.com/mendrik-private/diorama</url>
  <translation type="gettext">diorama</translation>
  <launchable type="desktop-id">io.github.mendrik_private.Diorama.desktop</launchable>
  <content_rating type="oars-1.1" />
